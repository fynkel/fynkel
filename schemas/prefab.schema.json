    "prefabInstance": {
      "type": "object",
      "description": "Makes this entity a prefab instance: the prefab's roots are expanded as its children (after the authored ones), with prefab-local ids remapped per instance. Overrides apply in order.",
      "properties": {
        "asset": {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        },
        "instance": {
          "allOf": [
            {
              "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
            }
          ],
          "description": "Stable per instance; prefab-local ids are derived from it."
        },
        "overrides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/override"
          }
        }
      },
      "required": [
        "asset",
        "instance"
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "override": {
      "type": "object",
      "description": "One explicit operation on the instance, addressed by prefab-local ids (or ids introduced by an earlier addObject/addComponent). `setField` with a null value sets null; `unsetField` removes the field.",
      "properties": {
        "op": {
          "enum": [
            "setField",
            "unsetField",
            "addComponent",
            "removeComponent",
            "addObject",
            "removeObject"
          ]
        },
        "entity": {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
        },
        "component": {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "type": {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/typeId"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object"
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "addObject: prefab-local parent, or null for a new instance root."
        },
        "components": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
          },
          "additionalProperties": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "required": [
        "op",
        "entity"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "setField"
              }
            }
          },
          "then": {
            "required": [
              "component",
              "field",
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "unsetField"
              }
            }
          },
          "then": {
            "required": [
              "component",
              "field"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "addComponent"
              }
            }
          },
          "then": {
            "required": [
              "component",
              "type",
              "version",
              "data"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "removeComponent"
              }
            }
          },
          "then": {
            "required": [
              "component"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "addObject"
              }
            }
          },
          "then": {
            "required": [
              "name",
              "parent"
            ]
          }
        }
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": "array",
          "description": "Ordered child ids; every listed child must name this entity as its parent.",
          "items": {
            "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
          }
        },
        "components": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
          },
          "additionalProperties": {
            "$ref": "#/$defs/component"
          }
        },
        "editorNotes": {
          "type": "string"
        },
        "prefab": {
          "$ref": "#/$defs/prefabInstance"
        }
      },
      "required": [
        "name",
        "parent",
        "children",
        "components"
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    }
  }
}
