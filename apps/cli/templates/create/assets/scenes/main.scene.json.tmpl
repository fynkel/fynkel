{
  "$schema": "https://fynkel.dev/schemas/scene.schema.json",
  "formatVersion": 3,
  "id": "{{scene_id}}",
  "name": "Main",
  "entities": {
    "{{e_camera}}": {
      "name": "Camera",
      "parent": null,
      "children": [],
      "components": {
        "{{c_camera_transform}}": {
          "type": "fynkel.Transform",
          "version": 1,
          "data": {
            "position": [2.6, 1.9, 3.4],
            "rotation": [-0.149091, 0.3166601, 0.0504723, 0.935388],
            "scale": [1, 1, 1]
          }
        },
        "{{c_camera}}": {
          "type": "fynkel.Camera",
          "version": 1,
          "data": {
            "projection": "perspective",
            "fov_y": 0.9,
            "ortho_height": 10.0,
            "near": 0.1,
            "far": 100.0,
            "priority": 0,
            "exposure_mode": "auto",
            "exposure": 12.0
          }
        }
      }
    },
    "{{e_sun}}": {
      "name": "Sun",
      "parent": null,
      "children": [],
      "components": {
        "{{c_sun_transform}}": {
          "type": "fynkel.Transform",
          "version": 1,
          "data": {
            "position": [0, 5, 0],
            "rotation": [-0.5000251, 0.20001, 0.100005, 0.836642],
            "scale": [1, 1, 1]
          }
        },
        "{{c_sun}}": {
          "type": "fynkel.DirectionalLight",
          "version": 1,
          "data": {
            "color": [1.0, 0.98, 0.92],
            "intensity": 10000.0,
            "cast_shadows": true
          }
        }
      }
    },
    "{{e_cube}}": {
      "name": "Cube",
      "parent": null,
      "children": [],
      "components": {
        "{{c_cube_transform}}": {
          "type": "fynkel.Transform",
          "version": 1,
          "data": {
            "position": [0, 0.5, 0],
            "rotation": [0, 0, 0, 1],
            "scale": [1, 1, 1]
          }
        },
        "{{c_cube_mesh}}": {
          "type": "fynkel.MeshRenderer",
          "version": 1,
          "data": {
            "mesh": {
              "asset": "{{cube_id}}",
              "sub": "mesh/0"
            },
            "material": {
              "asset": "{{material_id}}"
            },
            "cast_shadows": true,
            "receive_shadows": true,
            "visible": true
          }
        },
        "{{c_cube_body}}": {
          "type": "fynkel.RigidBody",
          "version": 1,
          "data": {
            "body_type": "kinematic",
            "mass": 0.0,
            "linear_damping": 0.0,
            "angular_damping": 0.0,
            "gravity_scale": 1.0,
            "ccd": false
          }
        },
        "{{c_cube_collider}}": {
          "type": "fynkel.Collider",
          "version": 1,
          "data": {
            "shape": "box",
            "size": [0.5, 0.5, 0.5],
            "mesh": null,
            "offset": [0, 0, 0],
            "friction": 0.5,
            "restitution": 0.0,
            "is_sensor": false,
            "layer": 1,
            "mask": 4294967295
          }
        },
        "{{c_cube_spinner}}": {
          "type": "game.Spinner",
          "version": 1,
          "data": {
            "speed": 1.5,
            "axis": [0, 1, 0]
          }
        },
        "{{c_cube_mover}}": {
          "type": "game.Mover",
          "version": 1,
          "data": {
            "speed": 2.0,
            "jumpHeight": 1.0
          }
        }
      }
    },
    "{{e_floor}}": {
      "name": "Floor",
      "parent": null,
      "children": [],
      "components": {
        "{{c_floor_transform}}": {
          "type": "fynkel.Transform",
          "version": 1,
          "data": {
            "position": [0, -0.5, 0],
            "rotation": [0, 0, 0, 1],
            "scale": [20, 1, 20]
          }
        },
        "{{c_floor_mesh}}": {
          "type": "fynkel.MeshRenderer",
          "version": 1,
          "data": {
            "mesh": {
              "asset": "{{cube_id}}",
              "sub": "mesh/0"
            },
            "material": {
              "asset": "{{material_id}}"
            },
            "cast_shadows": false,
            "receive_shadows": true,
            "visible": true
          }
        },
        "{{c_floor_collider}}": {
          "type": "fynkel.Collider",
          "version": 1,
          "data": {
            "shape": "box",
            "size": [0.5, 0.5, 0.5],
            "mesh": null,
            "offset": [0, 0, 0],
            "friction": 0.6,
            "restitution": 0.0,
            "is_sensor": false,
            "layer": 1,
            "mask": 4294967295
          }
        }
      }
    },
    "{{e_crate}}": {
      "name": "Crate",
      "parent": null,
      "children": [],
      "components": {
        "{{c_crate_transform}}": {
          "type": "fynkel.Transform",
          "version": 1,
          "data": {
            "position": [-1.6, 1.6, -0.4],
            "rotation": [0, 0.258819, 0, 0.9659258],
            "scale": [1, 1, 1]
          }
        },
        "{{c_crate_mesh}}": {
          "type": "fynkel.MeshRenderer",
          "version": 1,
          "data": {
            "mesh": {
              "asset": "{{cube_id}}",
              "sub": "mesh/0"
            },
            "material": {
              "asset": "{{material_id}}"
            },
            "cast_shadows": true,
            "receive_shadows": true,
            "visible": true
          }
        },
        "{{c_crate_body}}": {
          "type": "fynkel.RigidBody",
          "version": 1,
          "data": {
            "body_type": "dynamic",
            "mass": 1.0,
            "linear_damping": 0.0,
            "angular_damping": 0.05,
            "gravity_scale": 1.0,
            "ccd": false
          }
        },
        "{{c_crate_collider}}": {
          "type": "fynkel.Collider",
          "version": 1,
          "data": {
            "shape": "box",
            "size": [0.5, 0.5, 0.5],
            "mesh": null,
            "offset": [0, 0, 0],
            "friction": 0.5,
            "restitution": 0.1,
            "is_sensor": false,
            "layer": 2,
            "mask": 4294967295
          }
        }
      }
    }
  }
}
