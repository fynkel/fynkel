// The menus are ordinary widgets (ADR-0062), so they are tested like any
// Flutter widget: no world, no GPU, a settings store in memory.

import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:fynkel/gameplay.dart' show SettingsStore;
import 'package:{{package}}/ui/menus.dart';

Widget _app(Widget child) => MaterialApp(
  theme: ThemeData.dark(useMaterial3: true),
  home: Scaffold(body: child),
);

void main() {
  testWidgets('the title screen calls back for each button', (tester) async {
    final pressed = <String>[];
    await tester.pumpWidget(
      _app(
        TitleScreen(
          title: 'My Game',
          onPlay: () => pressed.add('play'),
          onSettings: () => pressed.add('settings'),
          onQuit: () => pressed.add('quit'),
        ),
      ),
    );
    expect(find.text('My Game'), findsOneWidget);
    for (final label in ['Play', 'Settings', 'Quit']) {
      await tester.tap(find.text(label));
    }
    expect(pressed, ['play', 'settings', 'quit']);
  });

  testWidgets('the pause menu resumes, opens settings, returns to the title and quits', (tester) async {
    final pressed = <String>[];
    await tester.pumpWidget(
      _app(
        PauseMenu(
          onResume: () => pressed.add('resume'),
          onSettings: () => pressed.add('settings'),
          onMainMenu: () => pressed.add('menu'),
          onQuit: () => pressed.add('quit'),
        ),
      ),
    );
    for (final label in ['Resume', 'Settings', 'Main menu', 'Quit']) {
      await tester.tap(find.text(label));
    }
    expect(pressed, ['resume', 'settings', 'menu', 'quit']);
  });

  testWidgets('the settings panel edits the settings document', (tester) async {
    final settings = SettingsStore(); // in memory: nothing is written
    final qualities = <String>[];
    var back = false;
    await tester.pumpWidget(
      _app(SettingsPanel(settings: settings, onBack: () => back = true, onQuality: qualities.add)),
    );

    await tester.tap(find.text('high'));
    await tester.pump();
    expect(settings.current.quality, 'high');
    expect(qualities, ['high']);

    await tester.tap(find.byType(Switch));
    await tester.pump();
    expect(settings.current.muted, isTrue);

    // Drag the master volume all the way left.
    await tester.drag(find.byType(Slider).first, const Offset(-1000, 0));
    await tester.pump();
    expect(settings.current.masterVolume, 0);

    // A change made elsewhere (Q in the game) shows in the open panel.
    settings.update(settings.current.copyWith(quality: 'low'));
    await tester.pump();
    final segmented = tester.widget<SegmentedButton<String>>(find.byType(SegmentedButton<String>));
    expect(segmented.selected, {'low'});

    await tester.tap(find.text('Back'));
    expect(back, isTrue);
  });
}
