name: {{package}}
description: "{{title}} — a Fynkel game (created by `fynkel create`)."
publish_to: none
version: 0.1.0+1

environment:
  sdk: ^3.13.0

dependencies:
  flutter:
    sdk: flutter
  # The Fynkel Dart SDK; its native-assets build hook provides the runtime
  # (ADR-0015: built from the checkout, or a prebuilt artifact once published).
  fynkel:
    path: {{fynkel}}
  # The Flutter host: the 3D viewport widget and the game loop
  # (FynkelGameView) over the same runtime.
  fynkel_flutter:
    path: {{fynkel_flutter}}

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^6.0.0
  # `fynkel codegen --project .` runs this through build_runner: every
  # @FynkelBehaviour class → lib/generated/behaviours.g.dart + schemas/.
  fynkel_generator:
    path: {{generator}}
  build_runner: ^2.16.0

flutter:
  uses-material-design: true
