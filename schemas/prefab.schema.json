        "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    },
    "roots": {
      "type": "array",
      "description": "The parentless entities, in instantiation order; must list each exactly once.",
      "items": {
        "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "entities",
    "roots"
  ],
  "patternProperties": {
    "^x-": true
  },
  "unevaluatedProperties": false,
