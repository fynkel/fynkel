{
  "$schema": "https://fynkel.dev/schemas/project.schema.json",
  "formatVersion": 1,
  "id": "a39bb8b0-ce7e-45b1-a48c-30d958c493f5",
  "name": "Fynkel Reference Game",
  "startupScene": {
    "asset": "65905281-dc97-58ac-8d21-f5fbbac251a9"
  },
  "assets": "assets",
  "inputActions": {
    "move": {
      "type": "axis2d",
      "description": "Walk, in the camera's frame.",
      "bindings": [
        "keyboard:WASD",
        "gamepad:leftStick",
        "touch:overlay/stick"
      ]
    },
    "look": {
      "type": "axis2d",
      "description": "Turn the camera: mouse pixels scaled to stick units (a 400 px sweep is a full deflection), or the right stick.",
      "bindings": [
        "mouse:delta*0.0025",
        "gamepad:rightStick",
        "touch:overlay/look"
      ]
    },
    "jump": {
      "type": "button",
      "bindings": [
        "keyboard:Space",
        "gamepad:south",
        "touch:overlay/jump"
      ]
    },
    "sprint": {
      "type": "button",
      "description": "Held: run.",
      "bindings": [
        "keyboard:ShiftLeft",
        "gamepad:leftShoulder",
        "touch:overlay/sprint"
      ]
    },
    "interact": {
      "type": "button",
      "description": "Use what the player stands on (the Switch opens the Gate).",
      "bindings": [
        "keyboard:E",
        "gamepad:west",
        "touch:overlay/interact"
      ]
    },
    "wave": {
      "type": "button",
      "description": "Wave: the upper-body layer plays once over whatever the legs do.",
      "bindings": [
        "keyboard:F",
        "gamepad:east",
        "touch:overlay/wave"
      ]
    },
    "pause": {
      "type": "button",
      "description": "Pause (the app reads it, not a behaviour).",
      "bindings": [
        "keyboard:Escape",
        "gamepad:menu"
      ]
    },
    "restart": {
      "type": "button",
      "description": "Reload the Playground.",
      "bindings": [
        "keyboard:R",
        "gamepad:north",
        "touch:overlay/restart"
      ]
    }
  },
  "physics": {
    "gravity": [
      0,
      -9.81,
      0
    ],
    "layers": [
      "default",
      "props",
      "player",
      "trigger"
    ]
  },
  "quality": {
    "default": "medium",
    "profiles": {
      "low": {
        "shadows": false,
        "msaa": 1,
        "renderScale": 0.75
      },
      "medium": {
        "shadowResolution": 1024,
        "msaa": 4
      },
      "high": {
        "shadowResolution": 4096,
        "msaa": 8,
        "anisotropy": 16
      }
    }
  },
  "components": {
    "fynkel.Transform": {
      "kind": "native"
    },
    "fynkel.MeshRenderer": {
      "kind": "native"
    },
    "fynkel.Camera": {
      "kind": "native"
    },
    "fynkel.DirectionalLight": {
      "kind": "native"
    },
    "fynkel.PointLight": {
      "kind": "native"
    },
    "fynkel.SpotLight": {
      "kind": "native"
    },
    "fynkel.Environment": {
      "kind": "native"
    },
    "fynkel.RigidBody": {
      "kind": "native"
    },
    "fynkel.Collider": {
      "kind": "native"
    },
    "fynkel.CharacterController": {
      "kind": "native"
    },
    "fynkel.ThirdPersonCamera": {
      "kind": "native"
    },
    "fynkel.Rotator": {
      "kind": "native"
    },
    "fynkel.Oscillate": {
      "kind": "native"
    },
    "fynkel.Follow": {
      "kind": "native"
    },
    "fynkel.LookAtCamera": {
      "kind": "native"
    },
    "fynkel.LifetimeDespawn": {
      "kind": "native"
    },
    "fynkel.Emitter": {
      "kind": "native"
    },
    "fynkel.TriggerZone": {
      "kind": "native"
    },
    "fynkel.Animator": {
      "kind": "native"
    },
    "fynkel.Skin": {
      "kind": "native"
    },
    "fynkel.AudioSource": {
      "kind": "native"
    },
    "fynkel.AudioListener": {
      "kind": "native"
    },
    "fynkel.Volume": {
      "kind": "native"
    },
    "game.Player": {
      "kind": "behaviour",
      "version": 1,
      "description": "Walks, sprints and jumps the character; dies on hazards; collects (lib/game/player.dart)."
    },
    "game.Collectible": {
      "kind": "behaviour",
      "version": 1,
      "description": "A coin: counts itself when the player enters its zone (lib/game/collectible.dart)."
    },
    "game.Switch": {
      "kind": "behaviour",
      "version": 1,
      "description": "A pad that opens its target Gate on interact while the player stands on it (lib/game/switch.dart)."
    },
    "game.Gate": {
      "kind": "behaviour",
      "version": 1,
      "description": "A slab that slides up when opened (lib/game/gate.dart)."
    }
  },
  "targets": {
    "macos": {
      "enabled": true,
      "profile": "dev"
    },
    "ios": {
      "enabled": true,
      "profile": "ios"
    },
    "android": {
      "enabled": false
    }
  }
}
