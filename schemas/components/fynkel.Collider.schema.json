{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fynkel.dev/schemas/components/fynkel.Collider.schema.json",
  "$comment": "GENERATED by `fynkel codegen`. Do not edit.",
  "title": "fynkel.Collider",
  "description": "A collision shape on the entity, in the entity's local frame scaled by the entity's world scale. Alone it is static geometry; with a `RigidBody` it is that body's shape.",
  "type": "object",
  "properties": {
    "shape": {
      "type": "string",
      "enum": [
        "box",
        "sphere",
        "capsule",
        "mesh"
      ],
      "x-fynkel": {
        "enum": "fynkel.ColliderShape",
        "order": 0
      }
    },
    "size": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Metres; what each component means depends on `shape`.",
      "x-fynkel": {
        "unit": "m",
        "order": 1
      }
    },
    "mesh": {
      "oneOf": [
        {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "The mesh sub-asset for `shape: mesh` (`mesh/<n>` of an imported glTF), ignored otherwise.",
      "x-fynkel": {
        "kind": "asset(mesh)",
        "order": 2
      }
    },
    "offset": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Local translation of the shape from the entity's origin, metres.",
      "x-fynkel": {
        "unit": "m",
        "order": 3
      }
    },
    "material": {
      "oneOf": [
        {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "A `.physicsmaterial.json` (ADR-0025): its friction, bounciness and combine rules replace `friction` and `restitution`. None: those two apply, averaged with the other collider's.",
      "x-fynkel": {
        "kind": "asset(physics_material)",
        "group": "Material",
        "order": 4
      }
    },
    "friction": {
      "type": "number",
      "description": "Coulomb friction coefficient, `>= 0` (0.5 is rubber on concrete); ignored when `material` names one.",
      "x-fynkel": {
        "min": 0,
        "step": 0.05,
        "group": "Material",
        "showIf": "!material",
        "order": 5
      }
    },
    "restitution": {
      "type": "number",
      "description": "Bounciness `0..=1`; ignored when `material` names one.",
      "x-fynkel": {
        "kind": "slider",
        "label": "Bounciness",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "group": "Material",
        "showIf": "!material",
        "order": 6
      }
    },
    "is_sensor": {
      "type": "boolean",
      "description": "A sensor reports trigger events and applies no forces.",
      "x-fynkel": {
        "label": "Sensor",
        "order": 7
      }
    },
    "mask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Which layers this collider collides with (bit `i` = the project's `layers[i]`; both sides must agree). Its own layer is its entity's `fynkel.Layer` (ADR-0020).",
      "x-fynkel": {
        "kind": "layerMask",
        "label": "Collides with",
        "order": 8
      }
    }
  },
  "required": [
    "shape",
    "size",
    "offset",
    "friction",
    "restitution",
    "is_sensor",
    "mask"
  ],
  "additionalProperties": false,
  "x-fynkel": {
    "kind": "component",
    "id": 11,
    "rust": "fynkel_physics::components::Collider",
    "wireSize": 96,
    "authored": true
  }
}
