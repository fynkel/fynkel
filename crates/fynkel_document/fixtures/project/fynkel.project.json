{
  "$schema": "https://fynkel.dev/schemas/project.schema.json",
  "formatVersion": 1,
  "id": "d0000000-0000-4000-8000-000000000001",
  "name": "Fixture Game",
  "startupScene": {
    "asset": "c0000000-0000-4000-8000-000000000030"
  },
  "assets": "assets",
  "inputActions": {
    "move": {
      "type": "axis2d",
      "description": "Walk.",
      "bindings": [
        "keyboard:WASD",
        "gamepad:leftStick",
        "touch:overlay/stick"
      ]
    },
    "jump": {
      "type": "button",
      "bindings": [
        "keyboard:Space",
        "gamepad:south",
        "touch:overlay/jump"
      ]
    },
    "look": {
      "type": "axis2d",
      "description": "Turn the third-person camera.",
      "bindings": [
        "mouse:delta",
        "gamepad:rightStick"
      ]
    },
    "pause": {
      "type": "button",
      "bindings": [
        "keyboard:Escape",
        "gamepad:start"
      ]
    }
  },
  "quality": {
    "default": "medium",
    "profiles": {
      "low": {
        "shadows": false,
        "msaa": 1,
        "renderScale": 0.75,
        "anisotropy": 1,
        "textureMaxSize": 1024
      },
      "medium": {
        "shadowResolution": 1024,
        "msaa": 4
      },
      "high": {
        "shadowResolution": 4096,
        "msaa": 8,
        "anisotropy": 16
      }
    }
  },
  "physics": {
    "gravity": [
      0,
      -9.81,
      0
    ],
    "layers": [
      "default",
      "props"
    ]
  },
  "components": {
    "fynkel.Transform": {
      "kind": "native"
    },
    "fynkel.MeshRenderer": {
      "kind": "native"
    },
    "fynkel.Camera": {
      "kind": "native"
    },
    "fynkel.DirectionalLight": {
      "kind": "native"
    },
    "fynkel.PointLight": {
      "kind": "native"
    },
    "fynkel.SpotLight": {
      "kind": "native"
    },
    "fynkel.Environment": {
      "kind": "native"
    },
    "fynkel.RigidBody": {
      "kind": "native"
    },
    "fynkel.Collider": {
      "kind": "native"
    },
    "fynkel.CharacterController": {
      "kind": "native"
    },
    "fynkel.ThirdPersonCamera": {
      "kind": "native"
    },
    "fynkel.Rotator": {
      "kind": "native"
    },
    "fynkel.Oscillate": {
      "kind": "native"
    },
    "fynkel.Follow": {
      "kind": "native"
    },
    "fynkel.LookAtCamera": {
      "kind": "native"
    },
    "fynkel.LifetimeDespawn": {
      "kind": "native"
    },
    "fynkel.Emitter": {
      "kind": "native"
    },
    "game.Spinner": {
      "kind": "behaviour",
      "version": 1,
      "description": "Rotates its object; a Dart Behaviour (M2-15)."
    }
  },
  "targets": {
    "macos": {
      "enabled": true,
      "profile": "dev"
    },
    "ios": {
      "enabled": true,
      "profile": "ios"
    },
    "android": {
      "enabled": false
    }
  }
}
