{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fynkel.dev/schemas/scene.schema.json",
  "$comment": "GENERATED by `fynkel codegen` from the document model and the Rust component schemas (ADR-0012). Do not edit.",
  "title": "Fynkel scene document",
  "description": "UUID-keyed entities and component instances; child order is stored per entity (blueprint §6). Semantic rules (dangling references, cycles, duplicate component types) are checked by `fynkel scene validate`, not by this schema.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://fynkel.dev/schemas/envelope.schema.json"
    }
  ],
  "properties": {
    "entities": {
      "type": "object",
      "description": "Entity records keyed by their persistent id. Roots are the entities with a null parent, in key order.",
      "propertyNames": {
        "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "required": [
    "entities"
  ],
  "patternProperties": {
    "^x-": true
  },
  "unevaluatedProperties": false,
  "$defs": {
    "entity": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": "array",
          "description": "Ordered child ids; every listed child must name this entity as its parent.",
          "items": {
            "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
          }
        },
        "components": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/uuid"
          },
          "additionalProperties": {
            "$ref": "#/$defs/component"
          }
        },
        "editorNotes": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "parent",
        "children",
        "components"
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/typeId"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "data": {
          "type": "object"
        },
        "editorNotes": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "version",
        "data"
      ],
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "fynkel.Transform"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://fynkel.dev/schemas/components/fynkel.Transform.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fynkel.MeshRenderer"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://fynkel.dev/schemas/components/fynkel.MeshRenderer.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fynkel.Camera"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://fynkel.dev/schemas/components/fynkel.Camera.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fynkel.DirectionalLight"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://fynkel.dev/schemas/components/fynkel.DirectionalLight.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fynkel.PointLight"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://fynkel.dev/schemas/components/fynkel.PointLight.schema.json"
              }
            }
          }
        }
      ]
    }
  }
}
