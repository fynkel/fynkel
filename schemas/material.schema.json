{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fynkel.dev/schemas/material.schema.json",
  "$comment": "GENERATED by `fynkel codegen` from `fynkel_core::material::PbrMaterial` (ADR-0012). Do not edit.",
  "title": "Fynkel material document",
  "description": "A shader id plus the values a material sets (blueprint §6 Materials and shaders). For the built-in `fynkel.pbr@1` the fields are those of the Rust `fynkel.PbrMaterial` record (factors, five texture slots, alpha mode, double-sidedness); every one is optional and defaults as stated. A custom shader instead takes typed `parameters` and `textures` checked against its manifest. Which group applies, ranges and slot existence are semantic rules (`fynkel material validate`). Shadow flags live on `fynkel.MeshRenderer`.",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://fynkel.dev/schemas/envelope.schema.json"
    }
  ],
  "properties": {
    "shader": {
      "oneOf": [
        {
          "$ref": "https://fynkel.dev/schemas/shader.schema.json#/$defs/shaderId"
        },
        {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        }
      ],
      "description": "The shader this material sets values for: the built-in `fynkel.pbr@1` (the fields below), or a `.shader` file by asset reference (`parameters` and `textures`, ADR-0031)."
    },
    "base_color": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "Linear RGBA factor; multiplies `base_color_texture`.",
      "default": [
        1.0,
        1.0,
        1.0,
        1.0
      ]
    },
    "metallic": {
      "type": "number",
      "description": "`0` dielectric … `1` metal; multiplies the B channel of `metallic_roughness_texture`.",
      "default": 0.0
    },
    "roughness": {
      "type": "number",
      "description": "`0` mirror … `1` fully rough; multiplies the G channel of `metallic_roughness_texture`.",
      "default": 0.5
    },
    "emissive": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "Linear RGB emitted light; multiplies `emissive_texture`.",
      "default": [
        0.0,
        0.0,
        0.0
      ]
    },
    "emissive_strength": {
      "type": "number",
      "description": "Scales `emissive`; values above 1 are HDR (`KHR_materials_emissive_strength`).",
      "default": 1.0
    },
    "normal_scale": {
      "type": "number",
      "description": "Scales the tangent-space normal's XY.",
      "default": 1.0
    },
    "occlusion_strength": {
      "type": "number",
      "description": "`0` ignores the occlusion texture … `1` applies it fully.",
      "default": 1.0
    },
    "alpha_mode": {
      "type": "string",
      "enum": [
        "opaque",
        "mask",
        "blend"
      ],
      "x-fynkel": {
        "enum": "fynkel.AlphaMode"
      },
      "default": "opaque"
    },
    "alpha_cutoff": {
      "type": "number",
      "description": "Used by `mask` only.",
      "default": 0.5
    },
    "double_sided": {
      "type": "boolean",
      "description": "Draw both faces (no back-face culling); flips the normal on the back face.",
      "default": false
    },
    "base_color_texture": {
      "oneOf": [
        {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "sRGB colour texture."
    },
    "normal_texture": {
      "oneOf": [
        {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Tangent-space normal map, OpenGL convention (+Y up), linear."
    },
    "metallic_roughness_texture": {
      "oneOf": [
        {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "glTF packing, linear: G = roughness, B = metallic."
    },
    "occlusion_texture": {
      "oneOf": [
        {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Ambient occlusion in R, linear."
    },
    "emissive_texture": {
      "oneOf": [
        {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "sRGB emissive colour texture."
    },
    "parameters": {
      "type": "object",
      "description": "Custom shaders only: parameter values; anything not set takes the manifest default.",
      "propertyNames": {
        "$ref": "https://fynkel.dev/schemas/shader.schema.json#/$defs/identifier"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 4
          }
        ]
      }
    },
    "textures": {
      "type": "object",
      "description": "Custom shaders only: texture slot → binding.",
      "propertyNames": {
        "$ref": "https://fynkel.dev/schemas/shader.schema.json#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/textureBinding"
      }
    }
  },
  "required": [
    "shader"
  ],
  "patternProperties": {
    "^x-": true
  },
  "unevaluatedProperties": false,
  "x-fynkel": {
    "kind": "record",
    "name": "fynkel.PbrMaterial",
    "rust": "fynkel_core::material::PbrMaterial",
    "wireSize": 184,
    "document": "material"
  },
  "$defs": {
    "textureBinding": {
      "type": "object",
      "properties": {
        "texture": {
          "$ref": "https://fynkel.dev/schemas/envelope.schema.json#/$defs/assetRef"
        },
        "colorSpace": {
          "enum": [
            "srgb",
            "linear"
          ],
          "description": "Overrides the slot's colour space."
        },
        "uvSet": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1,
          "default": 0
        },
        "sampler": {
          "$ref": "#/$defs/sampler"
        }
      },
      "required": [
        "texture"
      ],
      "additionalProperties": false
    },
    "sampler": {
      "type": "object",
      "properties": {
        "filter": {
          "enum": [
            "linear",
            "nearest"
          ],
          "default": "linear"
        },
        "mipmaps": {
          "type": "boolean",
          "default": true
        },
        "wrap": {
          "enum": [
            "repeat",
            "clamp",
            "mirror"
          ],
          "default": "repeat"
        },
        "anisotropy": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        }
      },
      "additionalProperties": false
    }
  }
}
