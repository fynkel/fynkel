        {
          "if": {
            "properties": {
              "type": {
                "const": "fynkel.Transform"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://fynkel.dev/schemas/components/fynkel.Transform.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "fynkel.MeshRenderer"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "https://fynkel.dev/schemas/components/fynkel.MeshRenderer.schema.json"
              }
