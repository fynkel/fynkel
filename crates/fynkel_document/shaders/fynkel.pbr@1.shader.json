{
  "$schema": "https://fynkel.dev/schemas/shader.schema.json",
  "formatVersion": 1,
  "id": "5d2b8c1e-9f3a-4a7c-8b6d-0e1f2a3b4c5d",
  "name": "Fynkel PBR",
  "description": "Built-in metallic-roughness PBR (glTF 2.0 material model). Colours are linear RGB; factors multiply the matching textures.",
  "shaderId": "fynkel.pbr@1",
  "source": { "builtin": "pbr" },
  "passes": ["opaque", "mask", "blend", "shadow"],
  "features": [],
  "parameters": {
    "baseColor": { "type": "color4", "default": [1.0, 1.0, 1.0, 1.0], "min": 0.0, "max": 1.0, "description": "Linear RGBA; multiplies the baseColor texture." },
    "metallic": { "type": "float", "default": 0.0, "min": 0.0, "max": 1.0 },
    "roughness": { "type": "float", "default": 0.5, "min": 0.0, "max": 1.0 },
    "emissive": { "type": "color3", "default": [0.0, 0.0, 0.0], "min": 0.0, "max": 1.0, "description": "Linear RGB; multiplies the emissive texture." },
    "emissiveStrength": { "type": "float", "default": 1.0, "min": 0.0, "description": "Scales emissive; values above 1 are HDR." },
    "normalScale": { "type": "float", "default": 1.0, "min": 0.0 },
    "occlusionStrength": { "type": "float", "default": 1.0, "min": 0.0, "max": 1.0 }
  },
  "textures": {
    "baseColor": { "colorSpace": "srgb", "default": "white" },
    "metallicRoughness": { "colorSpace": "linear", "default": "white", "description": "glTF packing: G = roughness, B = metallic." },
    "normal": { "colorSpace": "linear", "default": "normal", "description": "Tangent-space, OpenGL convention (+Y up)." },
    "occlusion": { "colorSpace": "linear", "default": "white", "description": "R channel." },
    "emissive": { "colorSpace": "srgb", "default": "black" }
  }
}
