{
  "$schema": "https://fynkel.dev/schemas/project.schema.json",
  "formatVersion": 1,
  "id": "3263c596-2c7d-4bca-94fb-618982e3fdb4",
  "name": "Fynkel Showcase",
  "startupScene": {
    "asset": "3a56fbbd-b340-41ca-ac2b-b5603d1dc0da"
  },
  "assets": "assets",
  "inputActions": {
    "move": {
      "type": "axis2d",
      "description": "Move the player.",
      "bindings": [
        "keyboard:WASD",
        "gamepad:leftStick",
        "touch:overlay/stick"
      ]
    },
    "jump": {
      "type": "button",
      "bindings": [
        "keyboard:Space",
        "gamepad:south",
        "touch:overlay/jump"
      ]
    }
  },
  "quality": {
    "default": "medium",
    "profiles": {
      "low": {
        "shadows": false,
        "msaa": 1,
        "renderScale": 0.75,
        "anisotropy": 1
      },
      "medium": {
        "shadowResolution": 2048,
        "msaa": 4
      },
      "high": {
        "shadowResolution": 4096,
        "msaa": 4,
        "anisotropy": 16,
        "renderScale": 1.5
      }
    }
  },
  "components": {
    "fynkel.Transform": {
      "kind": "native"
    },
    "fynkel.MeshRenderer": {
      "kind": "native"
    },
    "fynkel.Camera": {
      "kind": "native"
    },
    "fynkel.DirectionalLight": {
      "kind": "native"
    },
    "fynkel.PointLight": {
      "kind": "native"
    },
    "fynkel.SpotLight": {
      "kind": "native"
    },
    "fynkel.Environment": {
      "kind": "native"
    },
    "game.Spinner": {
      "kind": "behaviour",
      "version": 1,
      "description": "Rotates its object (lib/game/spinner.dart)."
    },
    "game.Orbit": {
      "kind": "behaviour",
      "version": 1,
      "description": "Circles its object around a target, looking at it (lib/game/orbit.dart)."
    }
  },
  "targets": {
    "macos": {
      "enabled": true,
      "profile": "dev"
    },
    "ios": {
      "enabled": true,
      "profile": "ios"
    },
    "android": {
      "enabled": false
    }
  }
}
