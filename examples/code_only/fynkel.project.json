{
  "$schema": "https://fynkel.dev/schemas/project.schema.json",
  "formatVersion": 2,
  "id": "659f8911-2878-4453-89de-98b01b64f325",
  "name": "Fynkel Code Only",
  "assets": "assets",
  "inputActions": {
    "move": {
      "type": "axis2d",
      "description": "Walk.",
      "bindings": [
        "keyboard:WASD",
        "gamepad:leftStick",
        "touch:overlay/stick"
      ]
    },
    "jump": {
      "type": "button",
      "bindings": [
        "keyboard:Space",
        "gamepad:south",
        "touch:overlay/jump"
      ]
    },
    "interact": {
      "type": "button",
      "description": "Press the switch.",
      "bindings": [
        "keyboard:E",
        "gamepad:west",
        "touch:overlay/interact"
      ]
    },
    "restart": {
      "type": "button",
      "description": "Start the level over.",
      "bindings": [
        "keyboard:R",
        "gamepad:north"
      ]
    },
    "pause": {
      "type": "button",
      "description": "Pause the game (the app's business, not a behaviour's).",
      "bindings": [
        "keyboard:Escape",
        "gamepad:menu"
      ]
    }
  },
  "layers": [
    "default",
    "props",
    "player",
    "trigger"
  ],
  "tags": [
    "player",
    "pickup"
  ],
  "physics": {
    "gravity": [
      0,
      -9.81,
      0
    ]
  },
  "quality": {
    "default": "medium",
    "profiles": {
      "low": {
        "shadows": false,
        "msaa": 1,
        "renderScale": 0.75
      },
      "medium": {
        "shadowResolution": 1024,
        "msaa": 4
      },
      "high": {
        "shadowResolution": 4096,
        "msaa": 8,
        "anisotropy": 16
      }
    }
  },
  "components": {
    "fynkel.Transform": {
      "kind": "native"
    },
    "fynkel.MeshRenderer": {
      "kind": "native"
    },
    "fynkel.Camera": {
      "kind": "native"
    },
    "fynkel.DirectionalLight": {
      "kind": "native"
    },
    "fynkel.PointLight": {
      "kind": "native"
    },
    "fynkel.SpotLight": {
      "kind": "native"
    },
    "fynkel.Environment": {
      "kind": "native"
    },
    "fynkel.RigidBody": {
      "kind": "native"
    },
    "fynkel.Collider": {
      "kind": "native"
    },
    "fynkel.CharacterController": {
      "kind": "native"
    },
    "fynkel.ThirdPersonCamera": {
      "kind": "native"
    },
    "fynkel.Rotator": {
      "kind": "native"
    },
    "fynkel.Oscillate": {
      "kind": "native"
    },
    "fynkel.Follow": {
      "kind": "native"
    },
    "fynkel.LookAtCamera": {
      "kind": "native"
    },
    "fynkel.LifetimeDespawn": {
      "kind": "native"
    },
    "fynkel.Emitter": {
      "kind": "native"
    },
    "fynkel.TriggerZone": {
      "kind": "native"
    },
    "fynkel.Animator": {
      "kind": "native"
    },
    "fynkel.Skin": {
      "kind": "native"
    },
    "fynkel.AudioSource": {
      "kind": "native"
    },
    "fynkel.AudioListener": {
      "kind": "native"
    },
    "fynkel.Volume": {
      "kind": "native"
    },
    "game.Player": {
      "kind": "behaviour",
      "version": 1,
      "description": "Walks, jumps, dies on the sweeper, keeps the clock (lib/game/player.dart)."
    },
    "game.Collectible": {
      "kind": "behaviour",
      "version": 1,
      "description": "A coin: scores and bursts when the player touches it (lib/game/collectible.dart)."
    },
    "game.Switch": {
      "kind": "behaviour",
      "version": 1,
      "description": "Opens its gate on the interact press (lib/game/switch.dart)."
    },
    "game.Gate": {
      "kind": "behaviour",
      "version": 1,
      "description": "Rises when opened (lib/game/gate.dart)."
    }
  },
  "modules": {
    "animation": false,
    "strip": true
  },
  "targets": {
    "macos": {
      "enabled": true,
      "profile": "dev"
    },
    "ios": {
      "enabled": true,
      "profile": "ios"
    },
    "android": {
      "enabled": false
    }
  }
}
