{
  "$schema": "https://fynkel.dev/schemas/project.schema.json",
  "formatVersion": 1,
  "id": "{{project_id}}",
  "name": "{{title}}",
  "startupScene": {
    "asset": "{{scene_id}}"
  },
  "assets": "assets",
  "inputActions": {
    "move": {
      "type": "axis2d",
      "description": "Move the player.",
      "bindings": [
        "keyboard:WASD",
        "gamepad:leftStick",
        "touch:overlay/stick"
      ]
    },
    "jump": {
      "type": "button",
      "bindings": [
        "keyboard:Space",
        "gamepad:south",
        "touch:overlay/jump"
      ]
    },
    "pause": {
      "type": "button",
      "description": "Pause the game (the app's business, not a behaviour's).",
      "bindings": [
        "keyboard:Escape",
        "gamepad:menu"
      ]
    }
  },
  "physics": {
    "gravity": [0, -9.81, 0],
    "layers": ["default", "props"]
  },
  "quality": {
    "default": "medium",
    "profiles": {
      "low": {
        "shadows": false,
        "msaa": 1,
        "renderScale": 0.75
      },
      "medium": {
        "shadowResolution": 1024,
        "msaa": 4
      },
      "high": {
        "shadowResolution": 4096,
        "msaa": 8,
        "anisotropy": 16
      }
    }
  },
  "components": {
    "fynkel.Transform": {
      "kind": "native"
    },
    "fynkel.MeshRenderer": {
      "kind": "native"
    },
    "fynkel.Camera": {
      "kind": "native"
    },
    "fynkel.DirectionalLight": {
      "kind": "native"
    },
    "fynkel.PointLight": {
      "kind": "native"
    },
    "fynkel.SpotLight": {
      "kind": "native"
    },
    "fynkel.Environment": {
      "kind": "native"
    },
    "fynkel.RigidBody": {
      "kind": "native"
    },
    "fynkel.Collider": {
      "kind": "native"
    },
    "fynkel.CharacterController": {
      "kind": "native"
    },
    "fynkel.ThirdPersonCamera": {
      "kind": "native"
    },
    "fynkel.Rotator": {
      "kind": "native"
    },
    "fynkel.Oscillate": {
      "kind": "native"
    },
    "fynkel.Follow": {
      "kind": "native"
    },
    "fynkel.LookAtCamera": {
      "kind": "native"
    },
    "fynkel.LifetimeDespawn": {
      "kind": "native"
    },
    "fynkel.Emitter": {
      "kind": "native"
    },
    "game.Spinner": {
      "kind": "behaviour",
      "version": 1,
      "description": "Rotates its object (lib/game/spinner.dart)."
    },
    "game.Mover": {
      "kind": "behaviour",
      "version": 1,
      "description": "Walks its object with `move`, hops on `jump` (lib/game/mover.dart)."
    }
  },
  "targets": {
    "macos": {
      "enabled": true,
      "profile": "dev"
    },
    "ios": {
      "enabled": true,
      "profile": "ios"
    },
    "android": {
      "enabled": false
    }
  }
}
